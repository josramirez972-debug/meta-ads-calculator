# Supabase Configuration (Opcional para modo local, requerido para persistencia y panel admin)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Traffiker Digital Contact Config
# Introduce el número internacional sin espacios ni símbolos, ej: 573001234567
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_TRAFFIKER_EMAIL=contacto@traffikerdigital.com

# Admin Security
ADMIN_SECRET_KEY=traffiker-admin-secret-replace-me
